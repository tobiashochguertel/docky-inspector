{
  "name": "docky-inspector",
  "version": "0.1.0",
  "description": "Live layout inspector for Docky's dock bar (Bun + TypeScript)",
  "type": "module",
  "scripts": {
    "build": "bun build ./public/app.ts --outdir ./public/dist --target browser",
    "dev": "bun run build && bun ./src/server.ts",
    "start": "bun ./src/server.ts"
  },
  "devDependencies": {
    "bun-types": "^1.4.2"
  }
}